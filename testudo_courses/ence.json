    {
      "code": "ENCE661",
      "name": "Project Cost Accounting and Finance",
      "credits": 3,
      "gen_eds": [],
      "grading_method": "Regular, Audit",
      "description": "This course reviews the fundamentals of accounting; examines project cost accounting principles, applications, and impact on profitability; examines the principles of activity based costing; covers the elements involved in cash management; introduces the framework for how projects are financed and the potential impact financing has on the projects; and a framework for evaluating PC based systems and what resources are needed for an effective project cost system.",
      "prerequisites": [],
      "corequisites": [],
      "restrictions": [],
      "is_offered_this_term": false,
      "num_sections": 0
    },
    {
      "code": "ENCE662",
      "name": "Introduction to Project Management",
      "credits": 3,
      "gen_eds": [],
      "grading_method": "Regular, Audit",
      "description": "Introduction to project management including: overview and concepts of project management (principles, body of knowledge, strategies); planning successful projects (defining, specifying, delivery options, scheduling, budgeting); implementing (organizing the team, work assignments, team building, effective leadership); executing (performance measurement, maintaining the schedule, adjustments/mid-course corrections, record keeping, status reporting, communications, managing conflict, time management); and closeout(performance measurement, maintaining the schedule, adjustments/mid-course corrections, record keeping, status reporting, communications, managing conflict, time management).",
      "prerequisites": [],
      "corequisites": [],
      "restrictions": [],
      "is_offered_this_term": false,
      "num_sections": 0
    },
    {
      "code": "ENCE673",
      "name": "Urban Transportation",
      "credits": 3,
      "gen_eds": [],
      "grading_method": "Regular, Audit, Sat-Fail",
      "description": "The contempory methodology of urban transportation planning. The urban transportation planning process, interdependence between the urban transportation system and the activity system, urban travel demand models, evaluation of urban transportation alternatives and their implementation.",
