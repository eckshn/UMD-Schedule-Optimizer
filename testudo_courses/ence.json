    {
      "code": "ENCE674",
      "name": "Urban Transit Planning and Rail Transportation Engineering",
      "credits": 3,
      "gen_eds": [],
      "grading_method": "Regular, Audit, Sat-Fail",
      "description": "Basic engineering components of conventional and high speed railroads and of air cushion and other high speed new technology. The study of urban rail and bus transit. The characteristics of the vehicle, the supporting way, and the terminal requirements will be evaluated with respect to system performance, capacity, cost, and level of service.",
