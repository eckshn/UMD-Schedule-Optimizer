    {
      "code": "HIST270",
      "name": "Science Fiction, Afrofuturism, and Colonialism",
      "credits": 3,
      "gen_eds": [
        [
          "DSHU"
        ]
      ],
      "grading_method": "Regular, Pass-Fail, Audit",
      "description": "Explores the history of science fiction writing in the context of genuine historical events and issues in the background of authors and in the narratives they create. There is a deep intersection with colonialism and racism -- one which was then traduced by two generations of sci-fi authors, and via Afrofuturism and dystopian Scifi, who turned around the genre to create a new set of plots and social messages. Students will leave the class with an appreciation of the difference between historical methodology and narrative, whether under the guise of fiction or speculative nonfiction. Students will encounter and understand cinematic and visual vocabularies as well as textual tropes.",
      "prerequisites": [],
      "corequisites": [],
      "restrictions": [],
      "is_offered_this_term": false,
      "num_sections": 0
