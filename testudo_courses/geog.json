  "courses": [
    {
      "code": "GEOG140",
      "name": "Natural Disasters: Earthquakes, Floods, and Fires",
      "credits": 3,
      "gen_eds": [
        [
          "DSNS",
          "SCIS"
        ]
      ],
      "grading_method": "Regular, Pass-Fail, Audit",
      "description": "Catastrophic Environmental Events (CCE) that are becoming more common in this time of global environmental change and it is essential that today's students be equipped with the knowledge and skills to be leaders as we, as a society, understand the upheaval that these CCEs are causing. Students will examine how CEEs shape human society and ecosystem from the interdisciplinary perspective afforded by the field of Geography. Students will use the latest geographic science concepts and techniques in exploring these events. Using satellite imagery they will gain a multi-scale perspective of the ecological and societal aspects of the events.",
      "prerequisites": [],
      "corequisites": [],
      "restrictions": [],
      "is_offered_this_term": false,
      "num_sections": 0
    },
    {
      "code": "GEOG172",
      "name": "Earth From Space",
      "credits": 3,
      "gen_eds": [
        [
          "DSNS",
          "SCIS"
        ]
      ],
      "grading_method": "Regular, Pass-Fail, Audit",
      "description": "Earth observations from space enable the mapping and monitoring of our changing planet.  This survey course reviews current observational capabilities and examines scientific applications in quantifying global environmental change. Drivers and outcomes of key dynamics will be illustrated and discussed, including sea and continental ice loss, deforestation, ocean warming, urbanization, agricultural expansion and intensification, and vegetation response to climate change.",
      "prerequisites": [],
      "corequisites": [],
      "restrictions": [],
      "is_offered_this_term": false,
      "num_sections": 0
    },
