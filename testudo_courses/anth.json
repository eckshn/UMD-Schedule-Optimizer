    {
      "code": "ANTH242",
      "name": "Fire, Farming and Climate Change: An Archaeology Take on the History of Human Impacts on our Planet",
      "credits": 3,
      "gen_eds": [
        [
          "DSHS",
          "SCIS"
        ]
      ],
      "grading_method": "Regular, Pass-Fail, Audit",
      "description": "An examination of why climate changes, the methods for recording climate change, and case studies of the varied responses of past human societies to climate change in different geographic regions and time periods with varying socio-political and economic systems.",
      "prerequisites": [],
      "corequisites": [],
      "restrictions": [],
      "is_offered_this_term": false,
      "num_sections": 0
    },
    {
      "code": "ANTH260",
      "name": "Introduction to Sociocultural Anthropology and Linguistics",
      "credits": 3,
      "gen_eds": [
        [
          "DSHS",
          "DVUP"
        ]
      ],
      "grading_method": "Regular, Pass-Fail, Audit",
